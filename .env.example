LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.8
MAX_LLM_ATTEMPTS=3
MAX_HISTORY_MESSAGES=30
# Comma-separated, e.g. https://station222.example.com,https://www.station222.example.com
CORS_ORIGINS=*
